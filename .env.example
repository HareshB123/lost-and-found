# Environment Configuration for CAMPUS TRACE
# Copy this file to .env or update js/config.js with your project credentials

# Supabase Project URL (From Project Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (Safe for frontend client)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Trusted Backend/Service Key (NEVER expose in client-side code; for Supabase Edge Functions only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
